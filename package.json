{
  "name": "job-hunter-api",
  "version": "1.0.0",
  "description": "Node.js (Express + MongoDB) API for the Job-Hunter AI web app",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build-vercel-api.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "migrate:sqlite": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate-sqlite-to-mongo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
