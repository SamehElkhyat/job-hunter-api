# Copy to .env.local (or .env) and fill in. .env files are git-ignored. Never commit real values.
# Deploying to Vercel? Set these in the project's Environment Variables instead (see DEPLOY.md).

# ---- MongoDB (required) ----------------------------------------------------------------------
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-hunter?retryWrites=true&w=majority
# Local MongoDB:   mongodb://127.0.0.1:27017/job-hunter
# URL-encode special characters in the password (e.g. @ becomes %40).
MONGODB_URI=
# Optional: overrides the database name taken from the URI.
MONGODB_DB_NAME=

# ---- Server ----------------------------------------------------------------------------------
PORT=4000
# Origin(s) allowed to call the API directly from a browser (comma separated).
# The web app normally calls the API server-side through its proxy, so this rarely matters.
WEB_ORIGIN=http://localhost:3000
# Shared secret the web app sends in the x-api-key header (>= 16 chars).
# REQUIRED on Vercel (the API refuses to serve data without it). Must equal the web project's API_ACCESS_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ACCESS_KEY=
# Seed the sample CV and demo applications into an empty database. Default: true in development, false in production.
SEED_DEMO_DATA=

# ---- AI (optional) ---------------------------------------------------------------------------
# Without a key the API uses the built-in local analysis engine.
ANTHROPIC_API_KEY=
# Model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
